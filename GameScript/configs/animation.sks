//animation// SakiEngine 动画定义文件
//
// --- 动画语法说明 ---
// 格式: 动画名称
// 关键帧定义(无缩进)
//
// 关键帧语法:
// ease <时间> <属性变化>
// linear <时间> <属性变化>
//
// 属性变化支持变量引用(从pose定义):
// xcenter+/-数值   : 水平位置偏移
// ycenter+/-数值   : 垂直位置偏移  
// scale+/-数值     : 缩放偏移
//
// 示例:
// jump
// ease 0.2 ycenter-0.5
// ease 0.2 ycenter+0.45

jump
ease 0.3 ycenter-0.05
ease 0.3 ycenter+0
//上下抽搐
jumptb
ease 0.3 ycenter-0.02
ease 0.3 ycenter+0.02
ease 0.3 ycenter-0.02
ease 0.3 ycenter+0.02
ease 0.3 ycenter-0.02
ease 0.3 ycenter+0.02
ease 0.15 ycenter+0.0

topin
ease 0.2 ycenter-0.08
ease 0.2 ycenter+0.01
ease 0.1 ycenter-0.01
ease 0.1 ycenter+0

topout
ease 0.2 ycenter-0
ease 0.2 ycenter+0.08
ease 0.1 ycenter-0.16
ease 0.1 ycenter+1.0


backjump
ease 0.3 ycenter+0 scale-0
ease 0.3 ycenter-0.05 scale+0.3
ease 0.3 ycenter+0 scale+0.3
ease 0.3 ycenter-0.05 scale+0.3
ease 0.3 ycenter+0 scale+0.3
ease 0.3 ycenter-0.05 scale+0.3
ease 0.3 ycenter+0 scale+0.3
ease 0.3 ycenter+0 scale-0
cgjump
scale+0.1
ease 0.3 ycenter-0.02
ease 0.3 ycenter+0

// 新的动画预设示例 - 支持您的语法需求
enhanced_jump
scale+0.15
ycenter-0.05
ease 0.2 ycenter-0.08
ease 0.2 ycenter+0.05
ease 0.1 ycenter+0

dramatic_entrance
xcenter-0.2
scale+0.3
alpha+0.5
ease 0.5 xcenter+0.2
ease 0.3 scale-0.1
ease 0.2 alpha-0.5

power_up
scale+0.2
ease 0.3 ycenter-0.02
ease 0.3 ycenter+0.02
ease 0.3 scale+0.1
ease 0.3 scale-0.3

zoomjumpin
ease 0.3 ycenter-0.05 scale+0.3
ease 0.3 ycenter+0.1 scale+0.3
//ease 3.0 ycenter+0.1 scale+0.3
//ease 0.3 ycenter+0 scale+0

zoomjumpout
ease 0.3 ycenter-0.05 scale-0.15
ease 0.15 ycenter-0
ease 0.15 ycenter-0.05
ease 0.15 ycenter-0
ease 0.15 ycenter-0.05

zoomjumpinout
ease 0.3 ycenter-0.05 scale+0.3
ease 0.3 ycenter+0.1 scale+0.3
ease 1.0 ycenter+0.1 scale+0.3
ease 0.3 ycenter-0.05 scale+0.15
ease 0.15 ycenter-0
ease 0.15 ycenter-0.05 scale+0
ease 0.15 ycenter-0
ease 0.3 ycenter+0
fadein
linear 0.5 alpha+1.0

fadeout
linear 0.5 alpha-1.0

shake
ease 0.05 xcenter+0.02
ease 0.05 xcenter-0.02
ease 0.05 xcenter+0.02
ease 0.05 xcenter-0.02
ease 0.05 xcenter+0

shake2
ease 0.05 xcenter+0.005
ease 0.05 xcenter-0.005
ease 0.05 xcenter+0
//左右颤抖
bounce
ease 0.15 ycenter-0.08
ease 0.15 ycenter+0.08
ease 0.15 ycenter+0

ukeru
ease 0.15 ycenter-0.01
ease 0.15 ycenter+0

fururu
ease 0.07 ycenter-0.01
ease 0.1 ycenter-0

sky_anime
scale+0.5
ycenter+0.1
ease 3.0 ycenter-0.1
//天空运镜

cgchan
scale+0.5
xcenter-0.02
ycenter+0.2
ease 5.0 xcenter+0.05
ease 5.0 scale-0 ycenter-0 xcenter+0
cg1_4
scale+0.5
ease 2.0 scale-0
cg1_1
scale+1.5
ycenter-0.7
ease 1.0 ycenter-0.7
ease 2.0 scale-0 ycenter-0
attack_syozen
xcenter-0
ease 0.5 xcenter+0.25
ease 0.5 xcenter-0

// ---------------------------------------------------------------------------
// 第二章 Ren'Py 演出迁移预设。
// 所有数值均为相对 cp2* 舞台位的偏移，不直接照搬 Ren'Py 绝对坐标。

cp2jump
ease 0.10 ycenter-0.05
ease 0.20 ycenter+0

cp2jump2
ease 0.10 ycenter-0.05
ease 0.20 ycenter+0
ease 0.10 ycenter-0.05
ease 0.20 ycenter+0

// Ren'Py poose：0.2 秒放大后轻微上下回弹，并保持放大状态。
cp2enlarge_bounce
linear 0.20 ycenter+0.05 scale+0.40
linear 0.10 ycenter+0.07 scale+0.40
linear 0.10 ycenter+0.03 scale+0.40
linear 0.10 ycenter+0.05 scale+0.40

// Ren'Py bigjump：两段快速放大上弹，并停留在放大状态。
cp2bigjump
ease 0.05 ycenter+0.10
ease 0.05 ycenter+0.15 scale+0.40

// Ren'Py ajump4：从画面下方冲入后连续回弹。
cp2spring_in
ycenter+0.90
ease 0.10 ycenter+0.05
ease 0.10 ycenter-0.05
ease 0.075 ycenter+0.05
ease 0.075 ycenter-0.05
ease 0.10 ycenter+0

cp2hshake
linear 0.10 xcenter-0.008
linear 0.10 xcenter+0.008
linear 0.10 xcenter-0.008
linear 0.10 xcenter+0.008
linear 0.10 xcenter+0

cp2vshake
linear 0.10 ycenter-0.014
linear 0.10 ycenter+0.014
linear 0.10 ycenter-0.014
linear 0.10 ycenter+0.014
linear 0.10 ycenter+0

cp2tremble
ease 0.07 ycenter-0.01
ease 0.10 ycenter+0

cp2nod
ease 0.30 ycenter+0.03
ease 0.30 ycenter+0.01
ease 0.30 ycenter+0.03
ease 0.30 ycenter+0

cp2enter_right
xcenter+0.10
ease 0.30 xcenter+0

cp2enter_right2
xcenter+0.20
ease 0.30 xcenter+0

cp2enter_left
xcenter-0.10
ease 0.30 xcenter+0

cp2enter_left2
xcenter-0.20
ease 0.30 xcenter+0

cp2from_center_to_left
xcenter+0.30
ease 0.25 xcenter+0

cp2from_center_to_left2
xcenter+0.20
ease 0.25 xcenter+0

cp2from_center_to_right
xcenter-0.30
ease 0.25 xcenter+0

cp2from_center_to_right2
xcenter-0.20
ease 0.25 xcenter+0

cp2from_left_to_center
xcenter-0.30
ease 0.25 xcenter+0

cp2from_left2_to_center
xcenter-0.20
ease 0.25 xcenter+0

cp2from_right_to_center
xcenter+0.30
ease 0.25 xcenter+0

cp2from_right2_to_center
xcenter+0.20
ease 0.25 xcenter+0

cp2item_in
ycenter+1.08
ease 0.10 ycenter-0.05
ease 0.10 ycenter+0.05
ease 0.10 ycenter+0

cp2rise
ycenter+0.85
ease 0.30 ycenter+0.05
ease 0.30 ycenter-0.05
ease 0.30 ycenter+0

cp2fall
ease 0.25 ycenter+0.15 alpha-1.0

cp2grow
ease 0.10 ycenter+0.20 scale+0.25
ease 0.10 ycenter+0.10 scale+0.45
ease 0.10 ycenter+0.15 scale+0.40

cp2shrink
scale+0.40
ycenter+0.15
ease 0.10 ycenter-0.02 scale+0.38
ease 0.10 ycenter+0.02 scale+0.08
ease 0.10 ycenter+0 scale+0

cp2sky_pan
scale+0.20
ycenter+0.10
ease 7.0 ycenter-0.10
